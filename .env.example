# Copia este archivo a .env y reemplaza los valores por tus claves reales.
# El Orchestrator solo valida que estas variables EXISTAN al cargar
# config/providers.yml (ver src/config/loadConfig.ts); los nodos "stub"
# de este how-to nunca llaman realmente a un modelo, así que valores
# de relleno son suficientes para correr `npm run dev`.
ANTHROPIC_API_KEY=placeholder-anthropic-key
OPENAI_API_KEY=placeholder-openai-key
OPENROUTER_API_KEY=placeholder-openrouter-key

# Usado solo si más adelante cambias a un checkpointer persistente
# (por ejemplo PostgresSaver) en vez del MemorySaver por defecto.
# CHECKPOINT_DB_URL=postgres://user:password@localhost:5432/orchestrator
