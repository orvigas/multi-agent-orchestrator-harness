{
  "name": "multiagent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Harness multi-agente independiente, construido con LangGraph.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "execute": "tsx src/index.ts",
    "logs": "tsx src/orchestrator/harnessLogs.ts",
    "costs": "tsx src/orchestrator/harnessCosts.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/index.test.ts src/orchestrator/routing.test.ts src/orchestrator/nodes/implementation.test.ts src/workflows/knowledge-engine/routing.test.ts src/workflows/knowledge-engine/tools.test.ts src/workflows/planner/routing.test.ts src/workflows/planner/validatePlan.test.ts src/workflows/implementation/routing.test.ts src/workflows/implementation/tools/patchValidator.test.ts src/workflows/implementation/sandbox.test.ts src/workflows/implementation/quickChecks.test.ts src/workflows/validation-pipeline/routing.test.ts src/workflows/validation-pipeline/exec.test.ts src/workflows/recovery/routing.test.ts src/workflows/quality-gate/routing.test.ts src/workflows/quality-gate/checkCoverage.test.ts src/workflows/quality-gate/checkSonar.test.ts src/workflows/merge-manager/routing.test.ts src/workflows/merge-manager/detectConflicts.test.ts src/workflows/merge-manager/promotePatch.test.ts",
    "kb:index": "tsx src/workflows/knowledge-engine/indexing/buildIndexes.ts",
    "kb:demo": "tsx src/workflows/knowledge-engine/demo.ts",
    "planner:demo": "tsx src/workflows/planner/demo.ts",
    "implementation:demo": "tsx src/workflows/implementation/demo.ts",
    "validation:demo": "tsx src/workflows/validation-pipeline/demo.ts",
    "recovery:demo": "tsx src/workflows/recovery/demo.ts",
    "quality-gate:demo": "tsx src/workflows/quality-gate/demo.ts",
    "merge-manager:demo": "tsx src/workflows/merge-manager/demo.ts",
    "po:create": "tsx src/scripts/po-cli.ts create",
    "po:list": "tsx src/scripts/po-cli.ts list",
    "po:details": "tsx src/scripts/po-cli.ts details",
    "po:move": "tsx src/scripts/po-cli.ts move",
    "po:stats": "tsx src/scripts/po-cli.ts stats",
    "po:help": "tsx src/scripts/po-cli.ts help",
    "po:test": "tsx --test src/agents/product-owner/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@langchain/anthropic": "^0.3.14",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^0.2.44",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^0.4.4",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "ts-morph": "^24.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
