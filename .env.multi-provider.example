# Multi-Provider LLM Setup
# Copy to .env and fill in your actual API keys for Anthropic + OpenRouter configuration

# =============================================================================
# LLM PROVIDERS (pick which to enable)
# =============================================================================

# PRIMARY: Anthropic Claude (best for complex reasoning, code generation)
# Get key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-v0-...

# FALLBACK/COST-OPT: OpenRouter (access to multiple models, cheaper)
# Get key from: https://openrouter.ai/keys
# Supports: Qwen, Mistral, Meta Llama, and 100+ other models
OPENROUTER_API_KEY=sk-or-...

# FALLBACK: OpenAI (GPT-4, GPT-4o for last-resort reliability)
# Get key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...

# =============================================================================
# HARNESS BEHAVIOR
# =============================================================================

# Mode: "deterministic" (testing, no LLM costs) or "llm" (real LLM calls)
HARNESS_MODE=llm

# Optional: Force all roles to use specific provider (for testing)
# Uncomment to enable:
# FORCE_PROVIDER=openrouter
# FORCE_PROVIDER=anthropic

# Optional: Disable fallback chain (fail fast if primary fails)
# Uncomment to enable:
# DISABLE_PROVIDER_FALLBACK=true

# =============================================================================
# PER-ROLE PROVIDER OVERRIDE (advanced)
# =============================================================================

# Override provider for specific roles (useful for testing)
# Examples:
# DISCOVERY_PROVIDER=openrouter
# IMPLEMENTER_PROVIDER=anthropic
# RECOVERY_DIAGNOSTICIAN_PROVIDER=openai

# Override model for specific roles:
# DISCOVERY_MODEL=mistral-7b
# IMPLEMENTER_MODEL=claude-opus-5

# =============================================================================
# PERSISTENCE & STATE
# =============================================================================

# SQLite checkpoint database (configurable path)
CHECKPOINT_DB_PATH=./data/harness-checkpoints.db

# For future PostgreSQL setup (Phase 1.3):
# CHECKPOINT_DB_URL=postgres://user:password@localhost:5432/orchestrator

# =============================================================================
# OBSERVABILITY (optional)
# =============================================================================

# LangSmith tracing (see provider usage, token counts, latency)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=multiagent-harness

# Logging level
# LOGLEVEL=debug  # verbose provider fallback logs

# =============================================================================
# MULTI-PROVIDER SETUP EXAMPLES
# =============================================================================

# EXAMPLE 1: Cost-Optimized (30-40% savings)
# ─────────────────────────────────────────
# - Use OpenRouter for cheap roles (discovery, strategist)
# - Use Anthropic for complex roles (planner, implementer)
#
# Implementation:
#   1. Fill in ANTHROPIC_API_KEY and OPENROUTER_API_KEY above
#   2. Copy config/multi-provider-setup.example.yml "cost_optimized" section
#      to planner.yml, implementation.yml, recovery.yml
#   3. Run: HARNESS_MODE=llm npm run dev
#   4. Monitor: npm run harness:costs --days=1

# EXAMPLE 2: High-Availability (no single point of failure)
# ─────────────────────────────────────────────────────────
# - Each role distributed across providers
# - Automatic fallback if one provider is rate-limited
#
# Implementation:
#   1. Fill in all three API keys above
#   2. Copy config/multi-provider-setup.example.yml "high_availability" section
#   3. Run: HARNESS_MODE=llm npm run dev
#   4. Circuit breaker auto-opens after 5 failures per provider

# EXAMPLE 3: Quality-First (best output, higher cost)
# ────────────────────────────────────────────────────
# - All complex roles use Claude Opus
# - OpenAI as fallback only
#
# Implementation:
#   1. Fill in ANTHROPIC_API_KEY and OPENAI_API_KEY
#   2. Copy config/multi-provider-setup.example.yml "quality_first" section
#   3. Run: HARNESS_MODE=llm npm run dev

# EXAMPLE 4: Testing (cheap, fast iteration)
# ───────────────────────────────────────────
# - Use deterministic mode by default (no costs)
# - When LLM needed, use cheapest models
#
# Implementation:
#   1. Set HARNESS_MODE=deterministic (no API keys needed)
#   2. If you need LLM testing, fill in ANTHROPIC_API_KEY + OPENROUTER_API_KEY
#   3. Copy config/multi-provider-setup.example.yml "testing" section
#   4. Run: npm run dev (uses deterministic by default)

# =============================================================================
# RECOMMENDED STARTING CONFIGURATION
# =============================================================================

# For development/testing (cheapest):
#   HARNESS_MODE=deterministic
#   (no API keys needed)

# For production (balanced):
#   HARNESS_MODE=llm
#   Fill in: ANTHROPIC_API_KEY + OPENROUTER_API_KEY
#   Use: cost_optimized configuration

# For mission-critical (best quality):
#   HARNESS_MODE=llm
#   Fill in: All three API keys
#   Use: high_availability or quality_first configuration

# =============================================================================
# PROVIDER COSTS (approximate, as of 2026-07)
# =============================================================================

# Anthropic Claude:
#   - claude-opus-5: $15 per 1M input tokens
#   - claude-sonnet-5: $3 per 1M input tokens

# OpenRouter (varies by model):
#   - Mistral 7B: $0.15 per 1M input tokens (cheapest)
#   - Mistral Large: $1-2 per 1M input tokens
#   - Qwen Coder 32B: $2-3 per 1M input tokens
#   - Claude (via OpenRouter): $15 per 1M tokens

# OpenAI:
#   - GPT-4 Turbo: $10 per 1M input tokens
#   - GPT-4o: $5 per 1M input tokens

# SAVINGS EXAMPLE:
#   Baseline (all Anthropic Opus): $50 per 1000 tickets
#   Cost-optimized (mixed): $30-35 per 1000 tickets (30-40% savings)
#   Budget (all OpenRouter Mistral): $5 per 1000 tickets (90% savings, lower quality)

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Issue: "All providers exhausted" error
#   Solution: Verify all API keys are correct and active:
#   $ curl -H "Authorization: Bearer $ANTHROPIC_API_KEY" https://api.anthropic.com/v1/messages
#   $ curl -H "Authorization: Bearer $OPENROUTER_API_KEY" https://openrouter.ai/api/v1/models

# Issue: High latency with OpenRouter
#   Solution:
#     1. Check https://openrouter.ai/status for provider status
#     2. Try different model: FORCE_PROVIDER=openrouter DISCOVERY_MODEL=mistral-7b
#     3. Reduce timeout: set DISCOVERY_TIMEOUT=10_000 in config

# Issue: Rate-limited by Anthropic
#   Solution:
#     1. Circuit breaker auto-opens after 5 failures
#     2. System falls back to OpenRouter for 60 seconds
#     3. Monitor: npm run harness:logs --provider-breakdown

# =============================================================================
# USEFUL COMMANDS
# =============================================================================

# Test configuration (dry run, no changes):
# HARNESS_MODE=llm npm run dev -- --dry-run

# View provider usage:
# npm run harness:logs --provider-breakdown

# View cost breakdown:
# npm run harness:costs --days=7 --group-by=provider

# Force specific provider for testing:
# FORCE_PROVIDER=openrouter HARNESS_MODE=llm npm run dev

# Debug provider fallback:
# LOGLEVEL=debug HARNESS_MODE=llm npm run dev

# =============================================================================

# See docs/MULTI_PROVIDER_CONFIG.md for complete configuration guide
