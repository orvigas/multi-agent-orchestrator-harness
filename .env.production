# Production environment configuration for the Multi-Agent Harness
# IMPORTANT: This file is NOT committed to version control — copy to your deployment
# and replace placeholders with actual API keys from your providers.

# === LLM Providers (Required for HARNESS_MODE=llm)
# Get your API keys from:
# - Anthropic: https://console.anthropic.com/account/keys
# - OpenAI: https://platform.openai.com/account/api-keys
# - OpenRouter: https://openrouter.ai/keys

ANTHROPIC_API_KEY=sk-ant-v0-...    # Anthropic Claude models
OPENAI_API_KEY=sk-...               # OpenAI GPT-4o, GPT-4 Turbo
OPENROUTER_API_KEY=sk-or-...        # OpenRouter proxy (access multiple providers)

# === Harness Mode
# Set to "llm" to use real LLM calls with the providers above.
# Default "deterministic" uses heuristics instead (reproducible, no tokens used).
HARNESS_MODE=llm

# === Checkpoint Database (Persistent State Storage)
# SQLite file path for storing Orchestrator checkpoints between runs.
# Default: ./data/harness-checkpoints.db
# The directory will be auto-created on first run.
CHECKPOINT_DB_PATH=./data/harness-checkpoints.db

# === Optional: PostgreSQL (when scaling to multiple instances)
# For Phase 1.3: Uncomment and set this if deploying to production with multiple processes.
# Uses @langchain/langgraph-checkpoint-postgres (not yet implemented).
# CHECKPOINT_DB_URL=postgres://user:password@localhost:5432/orchestrator_harness

# === Optional: LangSmith Observability
# Enable detailed tracing of all Orchestrator runs (LangGraph + token usage).
# Get your API key from: https://smith.langchain.com/settings/api-keys
# Adds zero cost overhead — traces are streamed asynchronously.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=multiagent-harness
