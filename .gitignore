node_modules/
dist/
.env
.env.*.local
.harness.local/

# Harness — directorio independiente con su propia estructura
# (se puede remover sin afectar el proyecto host)
harness/node_modules/
harness/dist/
harness/.env
harness/.env.*.local

# Artefactos runtime del harness (generados por npm run dev, no código fuente)
.harness/releases.jsonl
.harness/escalations/
.harness/runs.jsonl
harness/data/

# Settings/estado locales de Claude Code (por-máquina/sesión, no compartidos).
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Cruft del sistema operativo / build.
.DS_Store
*.tsbuildinfo
